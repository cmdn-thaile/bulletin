# Postgres connection string.
# Local (docker compose up -d):
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/news-demo
# Supabase: use a pooler, not the direct db.<ref>.supabase.co host (IPv6 only, Vercel cannot reach it).
#   Vercel (DATABASE_URL env var): Transaction pooler, port 6543
#   migrate / seed from your machine: Session pooler, port 5432
#   URL-encode special characters in the password (@ -> %40, # -> %23, / -> %2F)
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# Signs auth tokens. Use a different random value per environment: openssl rand -hex 32
PAYLOAD_SECRET=YOUR_SECRET_HERE

# Vercel Blob for media uploads. Leave unset locally: files are stored in media/ instead.
# On Vercel it is added automatically when a Blob store is connected to the project.
# BLOB_READ_WRITE_TOKEN=vercel_blob_rw_<store-id>_<random>
